---

<footer class="footer">
  <div class="footer__cta-section">
    <h2 class="footer__cta-title">Build with us</h2>
    <p class="footer__cta-sub">Open source. Open network. Open to everyone.</p>
    <div class="footer__cta-actions">
      <a href="#" class="footer__btn footer__btn--primary">Start free</a>
      <a href="#" class="footer__btn footer__btn--outline">View on GitHub</a>
    </div>
  </div>

  <div class="footer__bar">
    <div class="footer__bar-inner">
      <div class="footer__brand">tar</div>

      <div class="footer__links">
        <a href="#">Terms</a>
        <a href="#">Privacy</a>
        <a href="#">Cookies</a>
      </div>

      <div class="footer__socials">
        <a href="#" aria-label="X">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" aria-label="GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #0a0a0a;
  }

  .footer__cta-section {
    padding: 72px 24px;
    text-align: center;
  }

  .footer__cta-title {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0 0 12px;
  }

  .footer__cta-sub {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 28px;
  }

  .footer__cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 600;
    font-size: 0.875rem;
    transition: background 0.15s, transform 0.1s;
  }

  .footer__btn--primary {
    background: #2563eb;
    color: #fff;
  }
  .footer__btn--primary:hover { background: #1d4ed8; }

  .footer__btn--outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .footer__btn--outline:hover { background: rgba(255, 255, 255, 0.08); }

  .footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__bar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer__brand {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .footer__links {
    display: flex;
    gap: 24px;
  }

  .footer__links a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__links a:hover { color: #fff; }

  .footer__socials {
    display: flex;
    gap: 16px;
  }

  .footer__socials a {
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .footer__socials a:hover { color: #fff; }

  @media (max-width: 640px) {
    .footer__bar-inner {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }
    .footer__cta-section {
      padding: 48px 20px;
    }
  }
</style>
