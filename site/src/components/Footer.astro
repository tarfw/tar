---
const columns = [
  {
    head: "Product",
    links: ["Spectrum", "iMessage", "WhatsApp", "Telegram", "Platform", "Pricing"],
  },
  {
    head: "Developers",
    links: ["Docs", "Resources", "Brand", "Changelog"],
  },
  {
    head: "Company",
    links: ["Overview", "Manifesto", "Blog", "Community", "Contact"],
  },
];
---

<footer class="footer">
  <div class="container">
    <!-- CTA -->
    <div class="footer__cta reveal">
      <span class="overline">Ready when you are</span>
      <h2 class="display footer__cta-title">Start building with tarapp today</h2>
      <div class="footer__cta-actions">
        <a href="#docs" class="btn btn--primary">View Docs</a>
        <a href="#expert" class="btn btn--ghost">Talk to an Expert</a>
      </div>
    </div>

    <!-- Link columns -->
    <div class="footer__cols">
      <div class="footer__brand-col">
        <a href="/" class="footer__logo">
          <span class="footer__logo-mark">
            <svg width="20" height="20" viewBox="0 0 28 28" fill="none">
              <rect x="0" y="0" width="4.5" height="4.44" fill="#392878"/>
              <rect x="4" y="0" width="4.5" height="4.44" fill="#392878"/>
              <rect x="20" y="0" width="4.5" height="4.44" fill="#392878"/>
              <rect x="24" y="0" width="4.5" height="4.44" fill="#392878"/>
              <rect x="4" y="3.94" width="4.5" height="4.44" fill="#392878"/>
              <rect x="8" y="3.94" width="4.5" height="4.44" fill="#392878"/>
              <rect x="12" y="3.94" width="4.5" height="4.44" fill="#392878"/>
              <rect x="16" y="3.94" width="4.5" height="4.44" fill="#392878"/>
              <rect x="20" y="3.94" width="4.5" height="4.44" fill="#392878"/>
              <rect x="0" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="4" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="8" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="12" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="16" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="20" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="24" y="7.89" width="4.5" height="4.44" fill="#392878"/>
              <rect x="0" y="11.83" width="4.5" height="4.44" fill="#392878"/>
              <rect x="4" y="11.83" width="4.5" height="4.44" fill="#392878"/>
              <rect x="12" y="11.83" width="4.5" height="4.44" fill="#392878"/>
              <rect x="20" y="11.83" width="4.5" height="4.44" fill="#392878"/>
              <rect x="24" y="11.83" width="4.5" height="4.44" fill="#392878"/>
              <rect x="0" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="4" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="8" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="12" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="16" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="20" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="24" y="15.77" width="4.5" height="4.84" fill="#392878"/>
              <rect x="0" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="4" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="8" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="12" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="16" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="20" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="24" y="20.11" width="4.5" height="4.84" fill="#392878"/>
              <rect x="0" y="24.45" width="4.5" height="2.67" fill="#392878"/>
              <rect x="12" y="24.45" width="4.5" height="2.67" fill="#392878"/>
              <rect x="24" y="24.45" width="4.5" height="2.67" fill="#392878"/>
              <rect x="12" y="26.62" width="4.5" height="1.88" fill="#392878"/>
            </svg>
          </span>
          <span class="footer__logo-text">tarapp</span>
        </a>
        <p class="footer__tagline">Bring your agents to the interfaces millions already use.</p>
      </div>
      {columns.map((col) => (
        <div class="footer__col">
          <h4 class="footer__col-head">{col.head}</h4>
          <ul class="footer__col-links">
            {col.links.map((l) => <li><a href="#{l.toLowerCase().replace(/\s+/g, '-')}">{l}</a></li>)}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="footer__bar">
      <div class="footer__status">
        <span class="footer__status-dot"></span>
        <span>All System Operational</span>
      </div>
      <p class="footer__copy">© tarapp 2026 All Rights Reserved.</p>
      <div class="footer__legal">
        <a href="#terms">Terms of Service</a>
        <a href="#privacy">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--bg), #070707);
    border-top: 1px solid var(--border-soft);
    padding-top: clamp(3rem, 8vw, 6rem);
  }
  .footer__cta {
    text-align: center;
    padding-bottom: clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--border-soft);
  }
  .footer__cta-title {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    font-style: italic;
    margin: 1.25rem auto 2rem;
    max-width: 16ch;
  }
  .footer__cta-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .footer__cols {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding: clamp(3rem, 6vw, 4.5rem) 0;
  }
  .footer__logo { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 600; font-size: 1.1rem; color: var(--text); }
  .footer__logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(0,187,255,0.14), rgba(187,136,255,0.14));
    border: 1px solid var(--border);
  }
  .footer__tagline { margin-top: 1rem; color: var(--text-mute); font-size: 0.9rem; max-width: 26ch; line-height: 1.6; }
  .footer__col-head { font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 1rem; }
  .footer__col-links { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__col-links a { color: var(--text-mute); font-size: 0.92rem; transition: color 0.15s ease; }
  .footer__col-links a:hover { color: var(--text); }
  .footer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--border-soft);
  }
  .footer__status { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--text-dim); font-family: var(--font-mono); }
  .footer__status-dot { width: 8px; height: 8px; border-radius: 50%; background: #37e0a0; box-shadow: 0 0 0 0 rgba(55, 224, 160, 0.5); animation: fpulse 2.4s infinite; }
  @keyframes fpulse {
    0% { box-shadow: 0 0 0 0 rgba(55, 224, 160, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(55, 224, 160, 0); }
    100% { box-shadow: 0 0 0 0 rgba(55, 224, 160, 0); }
  }
  .footer__copy { color: var(--text-mute); font-size: 0.82rem; }
  .footer__legal { display: flex; gap: 1.5rem; }
  .footer__legal a { color: var(--text-mute); font-size: 0.82rem; transition: color 0.15s ease; }
  .footer__legal a:hover { color: var(--text); }
  @media (max-width: 800px) {
    .footer__cols { grid-template-columns: 1fr 1fr; }
    .footer__brand-col { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .footer__cols { grid-template-columns: 1fr; }
    .footer__bar { flex-direction: column; text-align: center; }
  }
</style>

<style>
  .footer {
    background: #0a0a0a;
  }

  .footer__cta-section {
    padding: 72px 24px;
    text-align: center;
  }

  .footer__cta-title {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0 0 12px;
  }

  .footer__cta-sub {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 28px;
  }

  .footer__cta-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .footer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 600;
    font-size: 0.875rem;
    transition: background 0.15s, transform 0.1s;
  }

  .footer__btn--primary {
    background: #2563eb;
    color: #fff;
  }
  .footer__btn--primary:hover { background: #1d4ed8; }

  .footer__btn--outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .footer__btn--outline:hover { background: rgba(255, 255, 255, 0.08); }

  .footer__bar {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer__bar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer__brand {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .footer__links {
    display: flex;
    gap: 24px;
  }

  .footer__links a {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__links a:hover { color: #fff; }

  .footer__socials {
    display: flex;
    gap: 16px;
  }

  .footer__socials a {
    color: rgba(255, 255, 255, 0.5);
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .footer__socials a:hover { color: #fff; }

  @media (max-width: 640px) {
    .footer__bar-inner {
      flex-direction: column;
      gap: 16px;
      padding: 20px;
    }
    .footer__cta-section {
      padding: 48px 20px;
    }
  }
</style>
