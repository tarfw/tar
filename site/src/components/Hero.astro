---
---

<section class="hero">
  <div class="hero__visual">
    <img
      src="https://cdn.prod.website-files.com/61477f2c24a826836f969afe/6a231084ed9c142b6d5c41c6_hero-still_v3.avif"
      alt="Colorful playful contraption with tubes, balls, magnets, and funnel on green hills under blue sky."
      class="hero__image"
      width="2160"
      height="1215"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__overlay">
      <h1 class="hero__title">Build systems that move the world</h1>
      <p class="hero__subtitle">
        Open commerce &amp; logistics infrastructure — run AI agents, own your data, and trade without rent.
      </p>
      <div class="hero__actions">
        <a href="#" class="hero__btn hero__btn--primary">Start free</a>
        <a href="/plan" class="hero__btn hero__btn--secondary">See the plan</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: #fff;
  }

  .hero__visual {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .hero__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    padding: 64px 24px 72px;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.62) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      transparent 68%
    );
  }

  .hero__title {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: #fff;
    margin: 0;
    text-align: center;
  }

  .hero__subtitle {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    font-weight: 400;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    margin: 16px auto 0;
    max-width: 52ch;
    text-align: center;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 28px;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 24px;
    border-radius: 10px;
    text-decoration: none;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-weight: 600;
    font-size: 16px;
    transition: background 0.2s ease, transform 0.1s ease;
  }

  .hero__btn--primary {
    background: #2563eb;
    color: #fff;
  }

  .hero__btn--primary:hover {
    background: #1d4ed8;
    transform: translateY(-1px);
  }

  .hero__btn--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(4px);
  }

  .hero__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero__overlay {
      padding: 32px 18px 48px;
    }
  }
</style>
