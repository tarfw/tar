---
const channels = [
  { name: "WhatsApp", icon: "/icons/whatsapp.png" },
  { name: "Discord", icon: "/icons/discord.png" },
  { name: "Slack", icon: "/icons/slack.png" },
  { name: "Telegram", icon: "/icons/telegram.png" },
  { name: "Instagram", icon: "/icons/instagram.png" }
];
---

<section class="hero-section">
  <div class="hero-container">
    <h1 class="hero-title">
      Bring Agents to the<br />
      Interfaces Millions Already Use.
    </h1>

    <p class="hero-subtitle">
      <span class="muted-text">an open framework that connects your agents to</span>
      {channels.map((ch, idx) => (
        <span class="channel-inline">
          <span class="channel-pill">
            <img src={ch.icon} alt={`${ch.name} icon`} class="channel-icon" />
            <strong class="channel-name">{ch.name}</strong>
          </span>
          <span class="muted-text">{idx < channels.length - 1 ? "," : ","}</span>
        </span>
      ))}
      <br class="subtitle-break" />
      <span class="muted-text">and other interfaces people use every day.</span>
    </p>

    <div class="hero-cta">
      <a href="https://app.photon.codes" target="_blank" rel="noopener noreferrer" class="btn-get-started">
        Get Started
      </a>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 6rem 1.5rem 4rem;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    z-index: 10;
    font-family: "PolySans Arabic VF Variable Slim", "PolySans Arabic VF Variable Slim Placeholder", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: flex-start;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.08;
    letter-spacing: -0.035em;
    margin: 0;
    font-family: "PolySans Arabic VF Variable Slim", "PolySans Arabic VF Variable Slim Placeholder", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .hero-subtitle {
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.7;
    margin: 0;
    font-weight: 400;
    max-width: 950px;
    font-family: "PolySans Arabic VF Variable Slim", "PolySans Arabic VF Variable Slim Placeholder", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .muted-text {
    color: rgba(255, 255, 255, 0.55);
  }

  .channel-inline {
    display: inline;
    white-space: nowrap;
    margin-right: 0.3rem;
  }

  .channel-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    vertical-align: -0.15em;
    margin: 0 0.15rem;
  }

  .channel-icon {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    object-fit: cover;
    display: inline-block;
    flex-shrink: 0;
  }

  .channel-name {
    font-weight: 700;
    color: #ffffff;
    letter-spacing: -0.01em;
    font-family: "PolySans Arabic VF Variable Slim", "PolySans Arabic VF Variable Slim Placeholder", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .hero-cta {
    margin-top: 1rem;
  }

  .btn-get-started {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    background: #ffffff;
    color: #0e2a1a;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s ease, background-color 0.2s ease;
    font-family: "PolySans Arabic VF Variable Slim", "PolySans Arabic VF Variable Slim Placeholder", Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .btn-get-started:hover {
    transform: translateY(-2px);
    background: #f3f4f6;
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 4rem 1.25rem 3rem;
    }
    .channel-icon {
      width: 20px;
      height: 20px;
    }
  }
</style>
