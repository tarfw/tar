{
  "scope": "universal",
  "note": "Two tiers. error = regenerate. warning = log only. Flat, clean, shadow-free, gradient-free design.",
  "hard_slop": {
    "severity": "error",
    "rules": [
      "no_emoji_in_headings",
      "max_2_cta_per_section",
      "no_placeholder_text",
      "no_cliche_headlines",
      "no_fake_testimonials",
      "no_gradients",
      "no_shadows",
      "no_elevation",
      "no_floating_pill_badges",
      "no_floating_callout_boxes",
      "no_icon_background_circles",
      "no_floating_social_icons",
      "no_floating_note_boxes",
      "no_placeholder_images",
      "no_emoji_as_images",
      "no_solid_color_blocks_as_images",
      "no_svg_data_uris",
      "no_position_fixed",
      "z_index_max_100",
      "no_important",
      "height_max_100vh",
      "opacity_min_0_3",
      "grid_columns_max_4",
      "no_heavy_symmetry"
    ],
    "action": "regenerate"
  },
  "soft_slop": {
    "severity": "warning",
    "rules": [
      "minor_spacing_variance",
      "font_weight_range",
      "color_palette_width"
    ],
    "action": "log_only"
  }
}
