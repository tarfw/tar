{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taragent",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tard1",
      "database_id": "c8bf4ab0-d6ce-4d55-9934-285b3a7a0dec"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STOREFRONT_CACHE",
      "id": "9fcfbb6bc68542e7a6a3762dd61c6c10"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tar-storage"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
