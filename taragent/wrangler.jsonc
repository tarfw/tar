{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taragent",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tard1",
      "database_id": "c8bf4ab0-d6ce-4d55-9934-285b3a7a0dec"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STOREFRONT_CACHE",
      "id": "9fcfbb6bc68542e7a6a3762dd61c6c10"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EDITOR", "class_name": "Editor" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Editor"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["Workspace", "Order"]
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 3 * * *"
    ]
  }
}
