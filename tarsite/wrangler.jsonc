{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tarsite",
  "main": "src/app.ts",
  "compatibility_date": "2024-02-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "*.tarai.space/*",
      "zone_name": "tarai.space"
    },
    {
      "pattern": "tarai.space/*",
      "zone_name": "tarai.space"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tard1",
      "database_id": "78c14306-d78a-4152-8c3e-bbc87cb1ef5b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "STOREFRONT_CACHE",
      "id": "9fcfbb6bc68542e7a6a3762dd61c6c10"
    }
  ],
  "r2_buckets": [
    {
      "binding": "THEMES_BUCKET",
      "bucket_name": "tar-themes"
    },
    {
      "binding": "SITES_BUCKET",
      "bucket_name": "tar-sites"
    }
  ],
